{
  "expo": {
    "name": "QuestFit",
    "slug": "QuestFit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.anonymous.QuestFit",
      "permissions": [
        "INTERNET",
        "ACTIVITY_RECOGNITION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ],
      "usesCleartextTraffic": true
    },
    "web": {
      "favicon": "./assets/favicon.jpg"
    },
    "plugins": [
      "expo-font",
      "expo-localization",
      "expo-dev-client",
      [
        "expo-camera",
        {
          "cameraPermission": "QuestFit needs access to your camera to scan barcodes and food."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "QuestFit needs access to your photos to analyze food images."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#40C057"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "c3642480-c672-460f-81f7-31e3f292eabe"
      }
    }
  }
}
